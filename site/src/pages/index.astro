---
import Base from "../layouts/Base.astro";
import DownloadHub from "../components/DownloadHub.astro";
import { site } from "../data/site";
---

<Base
  title={site.name}
  description="Download the OneSitting app to pass JAMB 2027, WAEC 2027 and Post-UTME 2027 at one sitting. Available on Android, iPhone and Windows laptops."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
    />
  </Fragment>
  <DownloadHub />
</Base>
