---
import Base from "../layouts/Base.astro";
import { site, whatsappUrl } from "../data/site";
import { categories, totalApps } from "../data/apps";

// Four headline categories on the home page; the full list lives on /apps.
const exams = categories.slice(0, 4);
---

<Base
  title={site.name}
  description="Klica Technologies builds exam preparation apps for JAMB, WAEC, NECO, BECE and Post-UTME across 20+ Nigerian universities, plus app, web and digital marketing services for businesses."
>
  <section class="hero center">
    <div class="wrap">
      <span class="eyebrow">{site.tagline}</span>
      <h1>Empowering students and businesses through <em>innovative software</em></h1>
      <p class="lede">
        We build exam preparation apps that help students excel in JAMB, WAEC, NECO
        and Post-UTME &mdash; alongside mobile, web and digital marketing services
        for businesses ready to grow.
      </p>
      <div class="cta-row">
        <a class="btn btn--gold" href="/apps/android">Download our apps</a>
        <a class="btn btn--ghost" href={whatsappUrl} target="_blank" rel="noopener">
          Talk to us on WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:1rem">
    <div class="stats">
      <div class="stat"><b>{totalApps}</b><span>Exams covered</span></div>
      <div class="stat"><b>23</b><span>Universities covered</span></div>
      <div class="stat"><b>3+</b><span>Years building for students</span></div>
      <div class="stat"><b>5</b><span>West African countries</span></div>
    </div>
  </section>

  <section class="section wrap">
    <div class="center">
      <span class="eyebrow">What we do</span>
      <h2>Built for students. Available for businesses.</h2>
    </div>

    <div class="grid grid--3" style="margin-top:2.5rem">
      <article class="card">
        <h3>Exam preparation apps</h3>
        <p>
          Practise real past questions for UTME, WAEC, NECO, BECE and Post-UTME on
          Android and Windows, offline and on your own schedule.
        </p>
        <a class="app__cta" href="/apps">Explore the catalogue &rarr;</a>
      </article>

      <article class="card">
        <h3>App &amp; web development</h3>
        <p>
          Need an app or a website for your business? Our team designs, builds and
          ships it &mdash; then keeps it running.
        </p>
        <a class="app__cta" href="/services">See our services &rarr;</a>
      </article>

      <article class="card">
        <h3>Digital marketing</h3>
        <p>
          Reach the customers already searching for you, with campaigns run by people
          who understand the local market.
        </p>
        <a class="app__cta" href="/contact">Start a conversation &rarr;</a>
      </article>
    </div>
  </section>

  <section class="section wrap">
    <div class="center">
      <span class="eyebrow">Exam categories</span>
      <h2>Klica exam preparation apps</h2>
      <p class="lede">Cutting-edge practice tools, matched to the exam you are actually sitting.</p>
    </div>

    <div class="grid grid--3" style="margin-top:2.5rem">
      {
        exams.map((c) => (
          <article class="card">
            <h3>{c.title}</h3>
            <p style="font-size:.94rem">{c.blurb}</p>
            <a class="app__cta" href={`/apps/android#${c.slug}`}>
              Learn more &rarr;
            </a>
          </article>
        ))
      }
    </div>

    <div class="center" style="margin-top:2.5rem">
      <a class="btn btn--gold" href="/apps">Explore all exams</a>
    </div>
  </section>

  <section class="section wrap center">
    <h2>Didn&rsquo;t find the app you were looking for?</h2>
    <p class="lede">
      Tell us which exam you need and we will consider adding it in a future release.
    </p>
    <div class="cta-row">
      <a class="btn btn--gold" href="/contact">Request an app</a>
      <a class="btn btn--ghost" href={whatsappUrl} target="_blank" rel="noopener">Ask on WhatsApp</a>
    </div>
  </section>
</Base>
