---
import Base from "../../layouts/Base.astro";
import AppCatalogue from "../../components/AppCatalogue.astro";
import { forPlatform, ANDROID_APP_URL } from "../../data/apps";
import { whatsappUrl } from "../../data/site";

const cats = forPlatform("android");
const count = cats.reduce((n, c) => n + c.apps.length, 0);
---

<Base
  title="Android App"
  description="One Android app covering JAMB UTME CBT practice, WAEC, BECE and Post-UTME for 23 Nigerian universities including UNILAG, UI, OAU, ABU and UNN. Free on Google Play."
>
  <section class="section wrap center" style="padding-bottom:1rem">
    <span class="eyebrow">Android</span>
    <h1>One app, every exam</h1>
    <p class="lede">
      All {count} exams below now live in a single app. Install it once, then practise
      for any of them offline, whenever you have a spare moment.
    </p>
    <div class="cta-row">
      <a class="btn btn--gold" href={ANDROID_APP_URL} target="_blank" rel="noopener">
        Get it on Google Play
      </a>
    </div>
  </section>

  <div class="wrap">
    <AppCatalogue categories={cats} platform="android" />
  </div>

  <section class="section wrap center">
    <h2>Not seeing your exam?</h2>
    <p class="lede">Tell us which one you need and we will consider it for a future release.</p>
    <div class="cta-row">
      <a class="btn btn--gold" href="/contact">Request an app</a>
      <a class="btn btn--ghost" href={whatsappUrl} target="_blank" rel="noopener">Ask on WhatsApp</a>
    </div>
  </section>
</Base>
