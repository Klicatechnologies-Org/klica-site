---
import Base from "../../layouts/Base.astro";
import AppCatalogue from "../../components/AppCatalogue.astro";
import { forPlatform } from "../../data/apps";
import { whatsappUrl } from "../../data/site";

const cats = forPlatform("desktop");
const count = cats.reduce((n, c) => n + c.apps.length, 0);
---

<Base
  title="Desktop Apps"
  description="Klica exam preparation software for Windows — JAMB UTME CBT practice, WAEC, BECE and Post-UTME desktop apps that mirror the real CBT exam environment."
>
  <section class="section wrap center" style="padding-bottom:1rem">
    <span class="eyebrow">Windows</span>
    <h1>Desktop apps</h1>
    <p class="lede">
      {count} apps for a full-size screen and a real keyboard &mdash; the closest thing
      to the CBT hall itself.
    </p>
  </section>

  <div class="wrap">
    <AppCatalogue categories={cats} platform="desktop" />
  </div>

  <section class="section wrap center">
    <h2>Need a desktop app we have not built?</h2>
    <p class="lede">Send us the exam and we will look at adding it.</p>
    <div class="cta-row">
      <a class="btn btn--gold" href="/contact">Request an app</a>
      <a class="btn btn--ghost" href={whatsappUrl} target="_blank" rel="noopener">Ask on WhatsApp</a>
    </div>
  </section>
</Base>
