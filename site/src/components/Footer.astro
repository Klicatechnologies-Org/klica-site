---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();

const socials = [
  { key: "facebook", href: site.socials.facebook, label: "Facebook", d: "M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4v-2c0-.6.4-1 1-1Z" },
  { key: "twitter", href: site.socials.twitter, label: "X (Twitter)", d: "M17.5 3h3l-6.6 7.5L21.7 21h-6l-4.7-6.1L5.6 21h-3l7-8L2.6 3h6.2l4.2 5.6L17.5 3Zm-1 16h1.7L7.6 4.8H5.8L16.5 19Z" },
  { key: "linkedin", href: site.socials.linkedin, label: "LinkedIn", d: "M6.9 8H4.2v12h2.7V8Zm.2-3.4a1.6 1.6 0 1 0-3.2 0 1.6 1.6 0 0 0 3.2 0ZM20 20h-2.7v-6c0-1.6-.6-2.4-1.8-2.4-1 0-1.5.6-1.7 1.3v7.1h-2.7V8h2.7v1.2c.4-.7 1.4-1.5 2.9-1.5 2 0 3.3 1.3 3.3 4V20Z" },
  { key: "instagram", href: site.socials.instagram, label: "Instagram", d: "M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2Zm0 7.6a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm5.8-7.8a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0ZM16 3H8a5 5 0 0 0-5 5v8a5 5 0 0 0 5 5h8a5 5 0 0 0 5-5V8a5 5 0 0 0-5-5Zm3.4 13a3.4 3.4 0 0 1-3.4 3.4H8A3.4 3.4 0 0 1 4.6 16V8A3.4 3.4 0 0 1 8 4.6h8A3.4 3.4 0 0 1 19.4 8v8Z" },
];
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr__cols">
      <div>
        <Logo height={36} />
        <p class="muted" style="margin-top:1rem;font-size:.92rem;max-width:34ch">
          A leading educational technology company in Africa, building advanced
          learning tools that help students achieve better grades.
        </p>
      </div>

      <div>
        <h4>Apps</h4>
        <ul>
          <li><a href="/apps/android">Android Apps</a></li>
          <li><a href="/apps/desktop">Desktop Apps</a></li>
          <li><a href="/apps/ios">iOS Apps</a></li>
          <li><a href="/apps">All Platforms</a></li>
        </ul>
      </div>

      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/services">Services</a></li>
          <li><a href="/contact">Contact Us</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
        </ul>
      </div>

      <div>
        <h4>Get in touch</h4>
        <ul>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
        <div class="socials" style="margin-top:1rem">
          {
            socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={s.d} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="ftr__base">
      <span>&copy; {year} {site.name}. All rights reserved.</span>
      <span>Built for students across Nigeria and West Africa.</span>
    </div>
  </div>
</footer>
